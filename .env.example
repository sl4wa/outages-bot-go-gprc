# Only bot and notifier need a Telegram token. Never commit .env.
TELEGRAM_BOT_TOKEN=
TELEGRAM_API_URL=https://api.telegram.org
OUTAGE_API_URL='https://power-api.loe.lviv.ua/api/pw_accidents?pagination=false&otg.id=28&city.id=693'
NOTIFY_INTERVAL=1m
SCHEDULE_INTERVAL=15m
SCHEDULE_API_URL='https://api.loe.lviv.ua/api/menus?page=1&type=photo-grafic'

# Subscription persistence uses one JSON file per chat.
# The bot keeps conversations and its offset in memory.
DATA_DIR=data
